        <!-- Section 3: one history. Copy left, mock right. -->
        <section class="landing-row">
          <div class="landing-copy">
            <h2>Every machine, one history</h2>
            <p>
              A small client on each laptop and workstation uploads new sessions
              to one server. Projects are keyed by git remote, so the same repo
              across clones, worktrees, and machines collapses into one project.
              Full-text search across every transcript recovers the run you half
              remember.
            </p>
          </div>
          <div class="landing-mock">
            <div class="mock-frame mk-list">
              <div class="mk-facets">
                <div class="mk-facet">
                  <span class="label">Agent</span>
                  <span class="mk-frow"
                    ><span>claude</span><span class="mk-fc">812</span></span
                  ><span class="mk-frow"
                    ><span>codex</span><span class="mk-fc">341</span></span
                  ><span class="mk-frow"
